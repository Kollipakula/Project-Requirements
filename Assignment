function CustomerDetails({ customer }) {

  return (
    <div>

      <h2>Customer Details</h2>

      {customer ? (
        <div>
          <p>ID: {customer.id}</p>
          <p>First Name: {customer.firstName}</p>
          <p>Last Name: {customer.lastName}</p>
          <p>Email: {customer.email}</p>
        </div>
      ) : (
        <p>Select a customer</p>
      )}

    </div>
  );
}

export default CustomerDetails;
